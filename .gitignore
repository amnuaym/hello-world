# Local-only files: not part of the website or the repository.
# Only the website files at the root, assets/, services/, the tests, scripts,
# package.json, README.md and this file should ever be committed.

# Old copies of files kept on this computer
backup/
*.bak
*.old
*.orig
*~

# Local preview and desktop-app settings
.claude/
.preview/

# Secrets and credentials: never publish these
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*
*.token

# Archives and exported bundles
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Dependencies and build output (none are needed today)
node_modules/
dist/
build/
coverage/
.cache/

# Logs, temporary files and editor or operating-system clutter
*.log
*.tmp
*.temp
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.swp
